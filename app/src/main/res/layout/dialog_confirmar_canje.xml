<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottomsheet_white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Título -->
    <TextView
        android:id="@+id/tvTituloConfirmar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Confirmar canje?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="10dp" />

    <!-- CARD DEL CUPÓN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:orientation="horizontal"
        android:padding="15dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDescripcionCupon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="10% de descuento en tu próxima compra"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgCupon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_cupon"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_image_round" />
    </LinearLayout>

    <!-- LISTADO DE DATOS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="15dp">

        <!-- Puntos actuales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:text="Tus puntos actuales"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvPuntosActuales"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1250"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Puntos a canjear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:text="Puntos a canjear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvPuntosDescontar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="- 500"
                android:textColor="#FF5733"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Saldo final -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:text="Saldo final"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvSaldoFinal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="750"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- BOTÓN CONFIRMAR -->
    <Button
        android:id="@+id/btnConfirmar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirmar"
        android:layout_marginTop="20dp"
        android:padding="10dp"
        android:backgroundTint="#8BFF32" />

    <!-- BOTÓN CANCELAR -->
    <Button
        android:id="@+id/btnCancelar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancelar"
        android:backgroundTint="#CCCCCC"
        android:layout_marginTop="8dp" />

</LinearLayout>
