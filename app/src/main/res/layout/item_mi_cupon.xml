<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Avatar redondo -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cuponAvatar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp"
            android:layout_gravity="center_vertical">

            <ImageView
                android:id="@+id/cuponImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background"
                android:contentDescription="Imagen del cupón" />
        </androidx.cardview.widget.CardView>

        <!-- Texto del cupón -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/tvCuponTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Título del Cupón"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tvCuponDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción del cupón"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvCuponEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvCuponFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vence el: 00/00/0000"
                android:textSize="11sp"
                android:textColor="#999999"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvCuponCodigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AB12 - •••• - ••••"
                android:textSize="11sp"
                android:textColor="#999999"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Botón -->
        <Button
            android:id="@+id/btnMostrar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Mostrar"
            android:textColor="#4CAF50"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:background="@drawable/btn_mostrar"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
